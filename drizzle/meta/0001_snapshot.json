      "checkConstraints": {
        "activities_date_status_check": {
          "name": "activities_date_status_check",
          "value": "\"activities\".\"date_status\" in ('confirmed','tbd')"
        },
        "activities_event_status_check": {
          "name": "activities_event_status_check",
          "value": "\"activities\".\"event_status\" in ('scheduled','postponed','cancelled')"
        },
        "activities_editorial_status_check": {
          "name": "activities_editorial_status_check",
          "value": "\"activities\".\"editorial_status\" in ('draft','scheduled','published','archived')"
        },
        "activities_confirmed_date_check": {
          "name": "activities_confirmed_date_check",
          "value": "\"activities\".\"date_status\" != 'confirmed' or \"activities\".\"start_at\" is not null"
        },
        "activities_end_check": {
          "name": "activities_end_check",
          "value": "\"activities\".\"end_at\" is null or (\"activities\".\"start_at\" is not null and \"activities\".\"end_at\" >= \"activities\".\"start_at\")"
        },
        "activities_scheduled_publish_check": {
          "name": "activities_scheduled_publish_check",
          "value": "\"activities\".\"editorial_status\" != 'scheduled' or \"activities\".\"publish_at\" is not null"
        },
        "activities_unpublish_check": {
          "name": "activities_unpublish_check",
          "value": "\"activities\".\"unpublish_at\" is null or \"activities\".\"publish_at\" is null or \"activities\".\"unpublish_at\" > \"activities\".\"publish_at\""
        },
        "activities_version_check": {
          "name": "activities_version_check",
          "value": "\"activities\".\"version\" >= 1"
        }
      }
